# loadtest/Makefile.loadtest
# Подключается из корневого Makefile: include loadtest/Makefile.loadtest

LOADTEST_PROFILE ?= baseline
K6_IMAGE         := grafana/k6:0.54.0
NETWORK          ?= aiesec-backend         # ← ваша сеть (docker ps)
ROOT             := $(shell pwd)

K6_RUN = docker run --rm \
	--network $(NETWORK) \
	-v $(ROOT)/loadtest/k6:/scripts:ro \
	-v $(ROOT)/loadtest/data:/data:ro \
	-v $(ROOT)/loadtest/results:/results \
	-e BACKEND_URL=http://backend:8000 \
	-e MATCHER_URL=http://matcher:8000 \
	$(K6_IMAGE) run

# ---------- seed ----------
loadtest-seed:            ## seed N пользователей (N=50)
	@BASE_URL=$${BACKEND_URL:-http://localhost:8000} \
	 N=$(or $(N),50) \
	 bash loadtest/scripts/seed_users.sh loadtest/data/tokens.json
	@echo "tokens: $$(jq length loadtest/data/tokens.json)"

# ---------- matcher ----------
loadtest-matcher:         ## matcher baseline|stress|spike
	@mkdir -p loadtest/results && chmod 777 loadtest/results
	@docker run --rm --network $(NETWORK) curlimages/curl:8.10.1 \
		-sf http://matcher:8000/health > /dev/null \
		|| (echo "❌ matcher не отвечает на /health" && exit 1)
	$(K6_RUN) -e PROFILE=$(LOADTEST_PROFILE) \
		--summary-export=/results/matcher-$(LOADTEST_PROFILE).json \
		/scripts/matcher.js
	@bash loadtest/scripts/summarize.sh loadtest/results/matcher-$(LOADTEST_PROFILE).json

# ---------- backend ----------
loadtest-backend:         ## backend baseline|stress|spike
	@test -f loadtest/data/tokens.json || (echo "сначала: make loadtest-seed" && exit 1)
	@mkdir -p loadtest/results && chmod 777 loadtest/results
	@docker run --rm --network $(NETWORK) curlimages/curl:8.10.1 \
		-sf http://backend:8000/api/v1/health > /dev/null \
		|| (echo "❌ backend не отвечает на /api/v1/health" && exit 1)
	$(K6_RUN) -e PROFILE=$(LOADTEST_PROFILE) \
		--summary-export=/results/backend-$(LOADTEST_PROFILE).json \
		/scripts/backend.js
	@bash loadtest/scripts/summarize.sh loadtest/results/backend-$(LOADTEST_PROFILE).json

# ---------- e2e ----------
loadtest-e2e:             ## e2e: 10 VU × 5 мин
	@mkdir -p loadtest/results && chmod 777 loadtest/results
	$(K6_RUN) -e E2E_VUS=$(or $(VUS),10) -e E2E_DURATION=$(or $(DURATION),5m) \
		--summary-export=/results/e2e.json \
		/scripts/e2e.js
	@bash loadtest/scripts/summarize.sh loadtest/results/e2e.json

# ---------- комбо ----------
loadtest-baseline:        ## matcher + backend baseline
	$(MAKE) loadtest-matcher LOADTEST_PROFILE=baseline
	$(MAKE) loadtest-backend LOADTEST_PROFILE=baseline

loadtest-stress:          ## matcher + backend stress
	$(MAKE) loadtest-matcher LOADTEST_PROFILE=stress
	$(MAKE) loadtest-backend LOADTEST_PROFILE=stress

loadtest-clean:           ## удалить результаты
	rm -f loadtest/results/*.json

.PHONY: loadtest-seed loadtest-matcher loadtest-backend loadtest-e2e \
        loadtest-baseline loadtest-stress loadtest-clean