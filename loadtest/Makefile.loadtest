LOADTEST_COMPOSE := docker compose -f loadtest/docker-compose.loadtest.yml

.PHONY: loadtest-prepare loadtest-monitor loadtest-monitor-resources loadtest loadtest-stop

loadtest-prepare: ## Подготовить чистый стенд и каталог для нагрузочного теста
	bash loadtest/scripts/prepare.sh

loadtest-monitor: ## Запустить Prometheus и Grafana
	$(LOADTEST_COMPOSE) up -d --wait prometheus grafana

loadtest-monitor-resources: ## Подключить CPU и память контейнеров через Docker Stats API
	$(LOADTEST_COMPOSE) --profile resources up -d --wait prometheus grafana docker-metrics
	$(LOADTEST_COMPOSE) restart prometheus

loadtest: ## Запустить НТ-01, НТ-02 или НТ-03 (CASE=NT01|NT02|NT03)
	bash loadtest/scripts/run.sh "$(or $(CASE),NT01)" "$(USERS)" "$(HOLD_SECONDS)"

loadtest-stop: ## Остановить мониторинг, сохранив данные
	$(LOADTEST_COMPOSE) --profile resources down
