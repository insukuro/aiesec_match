# --- Postgres ---
POSTGRES_USER=match
POSTGRES_PASSWORD=admin
APP_DB=aiesec_match

# --- Пароли ролей (создаёт bootstrap.sql) ---
BACKEND_DB_PASSWORD=backend
PARSER_DB_PASSWORD=parser
MATCHER_DB_PASSWORD=matcher
MATCHER_CATALOG_SOURCE=db
# --- Backend ---
JWT_SECRET=dev-jwt
PROFILE_HMAC_SECRET=dev-hmac
BACKEND_PORT=8000
MATCHER_DATABASE_URL='postgresql+psycopg://matcher_writer:matcher@postgres:5432/aiesec_match_dev'
# --- Parser ---
PARSER_PORT=8001
PARSER_DB=aiesec_match
PARSER_ALLOW_NO_TOKEN=true
PARSER_SCHEDULER_ENABLED=false

# --- AIESEC (токены у тебя свои, оставляю как есть) ---
AIESEC_TOKEN=
AIESEC_REFRESH_TOKEN=
AIESEC_CLIENT_ID=
AIESEC_CLIENT_SECRET=
AIESEC_AUTH_URL=https://auth.aiesec.org/oauth/token
AIESEC_AUTH_ORIGIN=https://aiesec.org
AIESEC_TOKEN_CREATED_AT=1792257594
AIESEC_TOKEN_EXPIRES_IN=7200
PARSER_TOKEN_REFRESH_MARGIN_SEC=600

# --- Web (для vite dev) ---
VITE_API_URL=http://localhost:8000/api/v1