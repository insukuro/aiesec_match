# ============ Postgres ============
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=postgres
PARSER_DB=parser
PARSER_DB_PASSWORD=parser-change-me
BACKEND_DB_PASSWORD=backend-change-me

# ============ Parser ============
PARSER_PORT=8001

# Токен AIESEC. Достаточно ЛЮБОГО варианта:
#   а) готовый access_token (живёт ~2ч, сам не обновится);
#   б) refresh_token + client_id + client_secret (автообновление).
AIESEC_TOKEN=
AIESEC_REFRESH_TOKEN=
AIESEC_CLIENT_ID=
AIESEC_CLIENT_SECRET=
AIESEC_AUTH_URL=https://auth.aiesec.org/oauth/token
AIESEC_AUTH_ORIGIN=https://aiesec.org

# true — разрешает старт без токена (ждём PUT /admin/token).
PARSER_ALLOW_NO_TOKEN=false

PARSER_REQUEST_DELAY_SEC=0.7
PARSER_INCREMENTAL_INTERVAL_MINUTES=360
PARSER_RECONCILE_INTERVAL_HOURS=24
PARSER_INCREMENTAL_DATE_FILTER=created
PARSER_SCHEDULER_ENABLED=true